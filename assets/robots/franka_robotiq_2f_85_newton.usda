#usda 1.0
(
    "Experimental Newton inertia overlay. Generated by scripts/build_newton_asset.py. Robotiq CAD masses; uniform local collision-box inertia estimates."
    defaultPrim = "panda"
    subLayers = [
        @franka_robotiq_2f_85_isaac60.usd@
    ]
)

over "panda"
{
